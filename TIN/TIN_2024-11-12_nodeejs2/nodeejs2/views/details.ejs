<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Details</title>
</head>
<body>
  <div class="container">
    <h1>Customer Details</h1>
    <div class="details">
      <div><strong>ID:</strong> <%= customer.id %></div>
      <div><strong>Name:</strong> <%= customer.name %></div>
      <div><strong>Address:</strong> <%= customer.adress %></div>
    </div>
    <div class="back-link">
      <a href="/list">&larr; Back to Customers List</a>
    </div>
  </div>
</body>
</html>
